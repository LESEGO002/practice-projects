<Window x:Class="Logo_and_sound.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Logo_and_sound"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid> <!--start of parent -->
       
        

        <!--Grid page for logo-->
        
        <Grid><!--Start of Logo-->
            
            <!--Displaying Logo-->
            <Image 
                Height="250px"
                Width="400px"
                Source="/Goblin.jpg"
                Margin="0,0,0,100"
                
            />
            
            <!--Button to Start AI-->
            <Button 
                Content="Start ChatBot"
                Height="50px"
                Width="200px"
                Margin="0,300,0,0"
                
            />
            
            


        </Grid><!--End of logo-->



       
    </Grid> <!--end of parent-->
</Window>
