@model Raceday_poe.Models.EventModel

@{
    ViewData["Title"] = "Delete Event";
}

<style>
    .delete-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        padding: 35px;
        max-width: 650px;
        margin: 0 auto;
        border-top: 5px solid #e63946;
    }

        .delete-card h2 {
            font-weight: 800;
            color: #e63946;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .delete-card .warning {
            color: #777;
            margin-bottom: 25px;
        }

        .delete-card dt {
            color: #1d3557;
            font-weight: 700;
        }

    .btn-danger-race {
        background: #e63946;
        color: #fff;
        font-weight: 700;
        border: none;
        border-radius: 8px;
        padding: 11px 28px;
    }

        .btn-danger-race:hover {
            background: #c1121f;
            color: #fff;
        }

    .btn-cancel {
        color: #555;
        text-decoration: none;
        margin-left: 15px;
        font-weight: 600;
    }

        .btn-cancel:hover {
            color: #e63946;
        }
</style>

<div class="delete-card">
    <h2>Delete Event</h2>
    <p class="warning">Are you sure you want to delete this event? This cannot be undone.</p>

    <dl class="row">
        <dt class="col-sm-4">Name</dt>
        <dd class="col-sm-8">@Model.EventName</dd>

        <dt class="col-sm-4">Date</dt>
        <dd class="col-sm-8">@Model.EventDate.ToString("dd MMMM yyyy")</dd>

        <dt class="col-sm-4">Location</dt>
        <dd class="col-sm-8">@Model.EventLocation</dd>

        <dt class="col-sm-4">Status</dt>
        <dd class="col-sm-8">@Model.Eventstatus</dd>
    </dl>

    <form asp-action="DeleteEventConfirmed">
        <input type="hidden" asp-for="EventId" />
        <button type="submit" class="btn-danger-race">Yes, Delete</button>
        <a asp-action="Events" class="btn-cancel">Cancel</a>
    </form>
</div>