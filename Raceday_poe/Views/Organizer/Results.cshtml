@model IEnumerable<Raceday_poe.Models.ResultModel>

@{
    ViewData["Title"] = "Results";
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .page-header h1 {
        font-weight: 800;
        color: #1d3557;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin: 0;
    }

    .btn-race {
        background-color: #e63946;
        color: #fff;
        border: none;
        padding: 10px 22px;
        font-weight: 600;
        border-radius: 25px;
        text-decoration: none;
        transition: 0.25s ease;
    }

    .btn-race:hover { background-color: #c1121f; color: #fff; }

    .results-table {
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .results-table thead {
        background: #1d3557;
        color: #fff;
    }

    .results-table th, .results-table td {
        padding: 13px 16px;
        vertical-align: middle;
    }

    .position-badge {
        background: #1d3557;
        color: #fff;
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.85rem;
    }
</style>

<div class="page-header">
    <h1>🏆 Race Results</h1>
    <a asp-action="CaptureResult" class="btn-race">+ Capture Result</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No results captured yet.</p>
}
else
{
    <div class="table-responsive results-table">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Participant</th>
                    <th>Finish Time</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.resultId</td>
                        <td><strong>@item.eventName</strong></td>
                        <td>@item.eventDate.ToString("dd MMM yyyy")</td>
                        <td>@item.categoryName</td>
                        <td>@item.participantEmail</td>
                        <td>@item.finishTime</td>
                        <td><span class="position-badge">@item.position</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
