@model Raceday_poe.Models.ResultModel

@{
    ViewData["Title"] = "Capture Result";
}

<style>
    .form-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        padding: 35px;
        max-width: 700px;
        margin: 0 auto;
        border-top: 5px solid #1d3557;
    }

    .form-card h2 {
        font-weight: 800;
        color: #1d3557;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 25px;
    }

    .form-card .form-label {
        font-weight: 600;
        color: #1d3557;
        font-size: 0.9rem;
    }

    .form-card .form-control {
        border-radius: 8px;
        padding: 10px 14px;
        border: 1.5px solid #d0d7de;
    }

    .form-card .form-control:focus {
        border-color: #1d3557;
        box-shadow: 0 0 0 0.2rem rgba(29,53,87,0.15);
    }

    .btn-race {
        background: #1d3557;
        color: #fff;
        font-weight: 700;
        border: none;
        border-radius: 8px;
        padding: 11px 30px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-race:hover { background: #142a45; color: #fff; }

    .btn-cancel {
        color: #555;
        text-decoration: none;
        margin-left: 15px;
        font-weight: 600;
    }

    .btn-cancel:hover { color: #e63946; }
</style>

<div class="form-card">
    <h2>🏆 Capture Race Result</h2>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-danger">@ViewBag.Message</div>
    }

    <form asp-action="CaptureResult" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="BibNumber" class="form-label">Bib Number</label>
                <input asp-for="BibNumber" class="form-control" type="number" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="eventName" class="form-label">Event Name</label>
                <input asp-for="eventName" class="form-control" placeholder="e.g. Durban July" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="finishTime" class="form-label">Finish Time (e.g. 01:23:45)</label>
            <input asp-for="finishTime" class="form-control" placeholder="HH:MM:SS" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="position" class="form-label">Finishing Position</label>
                <input asp-for="position" class="form-control" type="number" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ResultStatus" class="form-label">Result Status</label>
                <select asp-for="ResultStatus" class="form-control">
                    <option value="Finished">Finished</option>
                    <option value="DNF">DNF</option>
                    <option value="DNS">DNS</option>
                </select>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn-race">Save Result</button>
            <a asp-action="Results" class="btn-cancel">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
